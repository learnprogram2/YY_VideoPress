<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="yy_videopress"
        Arguments=""
        InstallLocation="C:\Program Files\Luxor\YY_VideoPress">
    </Installer>
    <PackageInformation
        PackageName="YY_VideoPress"
        PackageDisplayName="YY_VideoPress"
        PublisherName="CN=Luxor"
        PublisherDisplayName="Luxor"
        Version="0.1.0.0"
        PackageDescription="Compress and convert videos to keep your disk healthy">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="tech.luxor.yyvideopress"
                Description="Compress and convert videos to keep your disk healthy"
                DisplayName="YY_VideoPress"
                ExecutableName="yy_videopress"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>YY_VideoPress</DisplayName>
            <PublisherDisplayName>Luxor</PublisherDisplayName>
            <Description>Compress and convert videos to keep your disk healthy</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="yy_videopress.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
